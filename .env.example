# Copy to .env if you want to override the defaults.
# The API reads the process environment. It does not load this file itself.

ALTAS_ADDR=:8080
ALTAS_DB=data/altas.db
ALTAS_ENV=development
ALTAS_WEB_ORIGIN=http://127.0.0.1:5173
ALTAS_SESSION_TTL=168h
# Optional label in the sidebar. Empty uses the host name.
# ALTAS_ORG=
ALTAS_RESET_TTL=1h

# Host metrics. Paths are operator settings, not request parameters.
ALTAS_HOST_PROC=/proc
ALTAS_HOST_ROOT=/
ALTAS_PROJECTS_ROOT=/var/lib/altas/projects

# Read-only Compose inventory. Leave this off unless a Docker socket is mounted.
ALTAS_DOCKER_PROBE=0
# ALTAS_DOCKER_SOCKET=/var/run/docker.sock

# Official release checks. Auto-update stays off until an admin enables it.
# The release API host is pinned to api.github.com and is not an environment variable.
ALTAS_UPDATE_OWNER=junaidrehman04
ALTAS_UPDATE_REPO=altas-panel
ALTAS_UPDATE_INTERVAL=12h
ALTAS_UPDATE_UNIT=altas-panel
ALTAS_UPDATE_RESTART=systemd
# ALTAS_UPDATE_BINARY=/usr/local/bin/altas-panel
# Hex-encoded Ed25519 public key. Empty means SHA256 from the release checksum file is the gate.
# ALTAS_UPDATE_PUBKEY=
# Host history sample interval. Below 5s or above 5m falls back to 15s.
ALTAS_METRICS_INTERVAL=15s

# Optional MaxMind City or Country database. Absolute path. Missing leaves geo empty.
# ALTAS_GEOIP_DB=/var/lib/altas/GeoLite2-City.mmdb

# Optional Combined access log. Absolute path. Unset leaves the tail off.
# ALTAS_ACCESS_LOG=/var/log/nginx/access.log
