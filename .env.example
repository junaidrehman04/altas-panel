# Copy to .env if you want to override the defaults.
# The API reads the process environment. It does not load this file itself.

ALTAS_ADDR=:8080
ALTAS_DB=data/altas.db
ALTAS_ENV=development
ALTAS_WEB_ORIGIN=http://127.0.0.1:5173
ALTAS_SESSION_TTL=168h
ALTAS_RESET_TTL=1h

# Host metrics. Paths are operator settings, not request parameters.
ALTAS_HOST_PROC=/proc
ALTAS_HOST_ROOT=/
ALTAS_PROJECTS_ROOT=/var/lib/altas/projects

# Read-only Compose inventory. Leave this off unless a Docker socket is mounted.
ALTAS_DOCKER_PROBE=0
# ALTAS_DOCKER_SOCKET=/var/run/docker.sock
